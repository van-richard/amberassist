# PLUMED 2.9.4 well-tempered metadynamics smoke test.
UNITS LENGTH=A TIME=ps ENERGY=kcal/mol

WHOLEMOLECULES ENTITY0=1-24

d1: DISTANCE ATOMS=1,16 NOPBC
d2: DISTANCE ATOMS=5,23 NOPBC

wtmetad: METAD ARG=d1,d2 SIGMA=0.05,0.05 HEIGHT=0.001 PACE=2 BIASFACTOR=8 TEMP=300.0 FILE=step5.00_equilibration.wtmetad.HILLS GRID_MIN=0.0,0.0 GRID_MAX=15.0,15.0 GRID_BIN=300,300

PRINT ARG=d1,d2,wtmetad.bias STRIDE=1 FILE=step5.00_equilibration.wtmetad.COLVAR
