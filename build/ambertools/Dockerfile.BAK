# AmberTools 24 container (multi-arch) using micromamba
# Target platforms: linux/amd64 and linux/arm64
# Default shell opens with the AmberTools environment on PATH.

FROM mambaorg/micromamba:latest

# Use bash for RUN steps
SHELL ["/bin/bash", "-lc"]

# Name the environment explicitly for clarity/versioning
ARG ENV_NAME=ambertools-24

# Create the environment with AmberTools 24
# - conda-forge provides AmberTools prebuilt binaries
RUN micromamba create -y -n "${ENV_NAME}" -c conda-forge \
    ambertools=24 python=3.11 pip && \
    micromamba clean -a -y

# Ensure the Amber env is the default PATH and AMBERHOME is set
ENV CONDA_DEFAULT_ENV="${ENV_NAME}" \
    CONDA_PREFIX="/opt/conda/envs/${ENV_NAME}" \
    AMBERHOME="/opt/conda/envs/${ENV_NAME}" \
    PATH="/opt/conda/envs/${ENV_NAME}/bin:${PATH}"

# Non-root user provided by base image
WORKDIR /work
USER $MAMBA_USER

# Default to interactive shell
CMD ["bash"]

