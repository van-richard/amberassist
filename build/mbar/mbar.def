Bootstrap: docker
From: mambaorg/micromamba:1.5.8-bookworm

%labels
Author "Van"
Description "Apptainer image for custom pymbar (3.0.5) env with patched mbar_pmf2.py"
Version "2025-08-19"

%environment
export MAMBA_ROOT_PREFIX=/opt/conda
export CONDA_PREFIX=/opt/conda/envs/mbar
export PATH=/opt/conda/envs/mbar/bin:$PATH
export PYTHONNOUSERSITE=1
export PYTHONDONTWRITEBYTECODE=1
export PIP_NO_CACHE_DIR=1
export MPLBACKEND=Agg


%post
    set -eux
    rm -rf /var/lib/apt/lists/*


# micromamba root in /opt/conda or $HOME/micromamba if non-root
export MAMBA_ROOT_PREFIX=/opt/conda
mkdir -p "$MAMBA_ROOT_PREFIX"

# 1) Create the env with python pinned
micromamba create -y -n mbar -c conda-forge python=3.9.19

micromamba install -y -n mbar -c conda-forge pip=23.3.1 setuptools=68.2.2 wheel=0.41.2 numpy=1.26.4 scipy=1.13.0 pandas=2.2.1 python-dateutil=2.9.0 pytz=2024.1 typing_extensions=4.11.0 packaging=24.0 matplotlib=3.8.4 matplotlib-base=3.8.4 matplotlib-inline=0.1.6 seaborn-base=0.13.2 pillow=10.3.0 statsmodels=0.14.1 ipython=8.18.1 ipykernel=6.29.3 jupyter_client=8.6.1 jupyter_core=5.7.2 debugpy=1.8.1

# 3) Pip pins (match your env)
/opt/conda/envs/mbar/bin/pip install --no-cache-dir pymbar==3.0.5 scikit-learn==1.4.2 joblib==1.4.0 threadpoolctl==3.4.0

micromamba clean -a -y

# patch pymbar
PYMBARDIR="/opt/conda/envs/mbar/lib/python3.9/site-packages/pymbar"
mv /tmp/mbar_pmf.py ${PYMBARDIR}
mv ${PYMBARDIR}/__init__.py ${PYMBARDIR}/init.BAK
mv /tmp/init.PYPATCH ${PYMBARDIR}

# 5) Slim
find /opt/conda -type d -name "__pycache__" -exec rm -rf {} + || true
find /opt/conda/envs/mbar -type d -regex '.*\(tests\|test\|doc\|docs\|examples\).*' -prune -exec rm -rf {} + || true
find /opt/conda/envs/mbar -type f -name "*.a" -delete || true
find /opt/conda/envs/mbar -type f -name "*.la" -delete || true

%runscript
exec /opt/conda/envs/mbar/bin/python "$@"

%apprun mbar
exec /opt/conda/envs/mbar/bin/python "$@"
